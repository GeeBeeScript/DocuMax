# Copy to .env.local (Next.js) — the worker and scripts also read .env via dotenv.
# Values for local Supabase come from `npx supabase status`.

# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL — integration tests only (catalog checks)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://localhost:6379

# AI (provider-agnostic, see docs/DECISIONS.md ADR-003)
AI_PROVIDER=openrouter         # openrouter (default) | anthropic | openai | mock (dev/test only: deterministic, no key)
AI_MODEL=                      # optional; defaults: openrouter nvidia/nemotron-3.5-super-vl, anthropic claude-sonnet-5-5
OPENROUTER_ZDR=true            # route only to zero-data-retention endpoints (keep on for real documents)
AI_EFFORT=                     # optional: low | medium | high | xhigh | max (Anthropic reasoning effort)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=            # required for the default provider; AI_MODEL takes OpenRouter ids

# Stripe (Phase 10)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
