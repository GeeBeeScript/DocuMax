{
  "name": "documax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "queue:ping": "tsx scripts/queue-ping.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts && prettier --write lib/supabase/database.types.ts",
    "db:reset": "supabase db reset",
    "test:slow": "SLOW_TESTS=1 vitest run lib/pipeline",
    "eval:extraction": "tsx scripts/eval-extraction.ts"
  },
  "dependencies": {
